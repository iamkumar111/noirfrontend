NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_key_here

# Server-only production purchase-feed credentials. Use a Medusa v2 secret API
# key; leave it unset to return no public purchase notifications. Never expose
# this key with NEXT_PUBLIC_.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_API_KEY=
PURCHASE_NOTIFICATION_PUBLIC_ID_SECRET=

# Optional display pacing; production defaults are 8000–12000ms.
# PURCHASE_NOTIFICATION_INTERVAL_MIN=8000
# PURCHASE_NOTIFICATION_INTERVAL_MAX=12000
# PURCHASE_NOTIFICATION_PRIVACY_DELAY_MINUTES=5

# Development only. The code also requires NODE_ENV=development, so either
# synthetic feed can never activate on a production build.
# DEMO_PURCHASE_NOTIFICATIONS=false
# DEMO_VIEWING_NOTIFICATIONS=false
# PRODUCT_PRESENCE_TTL_SECONDS=105
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=in
NEXT_PUBLIC_SITE_URL=https://noir.relenshtech.com
